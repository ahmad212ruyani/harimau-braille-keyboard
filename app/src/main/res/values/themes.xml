<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HarimauBraille" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_light</item>

        <!-- Secondary / Accent Colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/text_light</item>

        <!-- Background & Surface Colors -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_light</item>

        <!-- Status & Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_light</item>
    </style>
</resources>
